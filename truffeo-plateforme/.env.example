# Supabase — projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ne jamais exposer côté client. Utilisée par les tâches cron uniquement.
SUPABASE_SERVICE_ROLE_KEY=

# Shopify — secret de l'app personnalisée qui porte l'App Proxy
SHOPIFY_APP_SECRET=

# Protège les routes cron Vercel
CRON_SECRET=
